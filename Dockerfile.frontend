# Dockerfile.frontend

# Stage 1: Build Python environment
FROM python:3.11-slim as python-builder

# Install dependencies (requests, openai, streamlit, pandas)
COPY ubos-copilot/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Stage 2: Final Image
FROM python-builder as runtime

# Set environment
WORKDIR /app
ENV STREAMLIT_SERVER_PORT 8501
EXPOSE 8501

# Copy application files (app.py)
COPY ubos-copilot/app.py /app/app.py

# Command to run the Streamlit application
ENTRYPOINT ["streamlit", "run", "app.py", "--server.port", "8501", "--server.baseUrlPath", "/"]